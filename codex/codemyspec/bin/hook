#!/bin/bash
# Route Codex hooks to the local cms server.
#
# Codex speaks the same hook dialect as Claude Code (snake_case payloads,
# `hook_event_name`, `hookSpecificOutput` responses), so this router POSTs
# to the same /api/hooks/* endpoints the Claude Code plugin uses.
#
# The cms server runs as a standalone service installed out-of-band — `brew
# services` (launchd) on macOS, the Shawl-wrapped Windows service via the MSI.
# This hook ONLY forwards events to the running server on its port; it does not
# install, start, or update the binary.
#
# If the server isn't running the POST simply fails and the hook is a no-op.

STDIN_DATA=$(cat)

# Default port is rewritten by the release packager when shipping the published
# plugin. CODEMYSPEC_PORT overrides for ad-hoc setups.
PORT="${CODEMYSPEC_PORT:-4003}"

EVENT=$(echo "$STDIN_DATA" | grep -o '"hook_event_name":"[^"]*"' | cut -d'"' -f4)

case "$EVENT" in
  SessionStart)      ENDPOINT="/api/hooks/session-start" ;;
  PreToolUse)        ENDPOINT="/api/hooks/pre-tool-use" ;;
  PostToolUse)       ENDPOINT="/api/hooks/post-tool-use" ;;
  Stop)              ENDPOINT="/api/hooks/stop" ;;
  SubagentStart)     ENDPOINT="/api/hooks/subagent-start" ;;
  SubagentStop)      ENDPOINT="/api/hooks/subagent-stop" ;;
  PermissionRequest) ENDPOINT="/api/permissions/request" ;;
  *)                 exit 0 ;;
esac

# Which working copy this is, read at request time. Same reasoning as the
# Claude plugin's router, which carries the long version: a published plugin is
# installed once and serves every checkout, so it can neither bake an id into
# its URLs nor take one from the environment, and without it the server falls
# back to guessing from a path.
#
# `.cms_harness.json` is in every working copy with the id in it. Walking up
# because a hook's cwd is wherever the agent is, not necessarily the root.
harness_id() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.cms_harness.json" ]; then
      # grep, not jq: jq is not a dependency and a hook that dies on a missing
      # binary is worse than one that sends no id.
      grep -o '"harness_id"[[:space:]]*:[[:space:]]*"[^"]*"' "$dir/.cms_harness.json" |
        head -1 | cut -d'"' -f4
      return
    fi
    dir="$(dirname "$dir")"
  done
}

ID="$(harness_id)"

if [ -n "$ID" ]; then
  curl -sS --fail --max-time 30 -X POST "http://localhost:${PORT}${ENDPOINT}" \
    -H "Content-Type: application/json" \
    -H "X-Working-Dir: $(pwd)" \
    -H "X-Harness-Id: $ID" \
    -d "$STDIN_DATA" 2>/dev/null
else
  curl -sS --fail --max-time 30 -X POST "http://localhost:${PORT}${ENDPOINT}" \
    -H "Content-Type: application/json" \
    -H "X-Working-Dir: $(pwd)" \
    -d "$STDIN_DATA" 2>/dev/null
fi

exit 0
