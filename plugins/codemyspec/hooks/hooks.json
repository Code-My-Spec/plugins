{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/session-start"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/pre-tool-use"
            ]
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/ask-user-question"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/post-tool-use"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/stop"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/subagent-start"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/hooks/subagent-stop"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cms-mcp-relay",
            "args": [
              "hook",
              "--port",
              "4003",
              "/api/permissions/request"
            ]
          }
        ]
      }
    ]
  }
}
