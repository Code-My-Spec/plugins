{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/session-start",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/pre-tool-use",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/ask-user-question",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/post-tool-use",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/stop",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/subagent-start",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-sS",
              "--max-time",
              "30",
              "-X",
              "POST",
              "http://localhost:4003/api/hooks/subagent-stop",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/bin/approve"
            ]
          }
        ]
      }
    ]
  }
}
